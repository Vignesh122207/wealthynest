{
  "app": "mvn -q compile exec:java",
  "watch": {
    "include": ["src/main/**"],
    "exclude": ["target/**", "**/*.md", "cdk.out/**"]
  },
  "context": {
    "@aws-cdk/core:target-partitions": ["aws"],
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/aws-ec2:uniqueImdsv2TemplateName": true,
    "@aws-cdk/aws-ec2:restrictDefaultSecurityGroup": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true,
    "@aws-cdk/aws-s3:serverAccessLogsUseBucketPolicy": true,
    "@aws-cdk/core:enablePartitionLiterals": true,
    "@aws-cdk/core:checkSecretUsage": true,

    "wealthynest:environments": {
      "production": {
        "account": "",
        "region": "ap-south-1",

        "domainName": "wealthynest.in",
        "apiSubdomain": "api.wealthynest.in",
        "cloudflareProxied": true,
        "githubRepo": "Vignesh122207/wealthynest",

        "vpcCidr": "10.20.0.0/16",
        "availabilityZones": ["ap-south-1a", "ap-south-1b"],
        "natGatewayEnabled": false,

        "ec2InstanceType": "t4g.small",
        "ec2Architecture": "arm64",
        "ec2RootVolumeGb": 30,
        "ec2AdminCidrForSsm": "",

        "rdsInstanceClass": "t4g.micro",
        "rdsAllocatedStorageGb": 20,
        "rdsMaxAllocatedStorageGb": 100,
        "rdsMultiAz": false,
        "rdsDeletionProtection": true,
        "rdsBackupRetentionDays": 7,
        "rdsPerformanceInsightsRetentionDays": 7,

        "redisNodeType": "cache.t4g.micro",
        "redisNumNodes": 1,

        "backupBucketGlacierTransitionDays": 30,
        "backupBucketExpirationDays": 365,
        "backupBucketNoncurrentExpirationDays": 30,

        "alarmEmail": "vikkysachin12@gmail.com",
        "logRetentionDays": 90,

        "cloudflareIpv4Ranges": [
          "173.245.48.0/20", "103.21.244.0/22", "103.22.200.0/22", "103.31.4.0/22",
          "141.101.64.0/18", "108.162.192.0/18", "190.93.240.0/20", "188.114.96.0/20",
          "197.234.240.0/22", "198.41.128.0/17", "162.158.0.0/15", "104.16.0.0/13",
          "104.24.0.0/14", "172.64.0.0/13", "131.0.72.0/22"
        ],
        "cloudflareIpv6Ranges": [
          "2400:cb00::/32", "2606:4700::/32", "2803:f800::/32", "2405:b500::/32",
          "2405:8100::/32", "2a06:98c0::/29", "2c0f:f248::/32"
        ]
      }
    }
  }
}
