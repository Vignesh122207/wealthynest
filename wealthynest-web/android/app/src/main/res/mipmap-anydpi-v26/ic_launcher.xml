<?xml version="1.0" encoding="utf-8"?>
<!-- No <inset> here — that was compensating for source PNGs generated at the
     legacy launcher size (48dp-based) instead of the full 108dp adaptive
     canvas, which upscaled blurry on real launchers. The mipmap sources are
     now generated at the correct 108dp-equivalent size per density with the
     mark already safe-zone-inset, so the drawables can be referenced directly. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>