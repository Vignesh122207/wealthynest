# Secrets — never commit
.env
.env.*
!.env.example

# Android signing keystore — permanent identity, never commit. Back this up somewhere durable
# outside git; losing it means losing the ability to ever update the Play Store listing.
android/keystore/

# macOS
.DS_Store

# IDE
.idea/
*.iml
.vscode/

# Build artifacts
target/
*.jar
*.war
.next/
node_modules/

# Android TWA build output (Bubblewrap-generated Gradle project + build artifacts) — regenerable
# from android/twa-manifest.json via `bubblewrap update && bubblewrap build`, not source.
android/app/build/
android/app/.cxx/
android/.gradle/
android/build/
android/*.apk
android/*.apk.idsig
android/*.aab
android/local.properties

# Claude Code local files
.claude/
