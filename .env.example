# Copy this file to .env and fill in your values
# cp .env.example .env

JWT_SECRET=your-256-bit-secret-here

# AES-256 key for vault (password manager) field encryption, base64-encoded
# (32 raw bytes). Generate with: openssl rand -base64 32. Never reuse across
# environments — rotating this makes all previously-stored vault items unreadable.
VAULT_ENCRYPTION_KEY=your-base64-encoded-32-byte-key-here

# Secret used to HMAC-hash vault passwords for reused-password detection (Vault Health).
# Deliberately separate from VAULT_ENCRYPTION_KEY. Generate with: openssl rand -base64 32.
VAULT_HASH_PEPPER=your-random-pepper-value-here

# Postgres/Redis credentials — used by docker-compose for both the containers
# themselves and the values the API connects with. Generate real random values,
# e.g. `openssl rand -base64 24 | tr -d '/+=' | head -c 32`. Never reuse the
# placeholder below.
DB_PASSWORD=change-this-to-a-strong-random-value
REDIS_PASSWORD=change-this-to-a-strong-random-value

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Brevo SMTP (smtp-relay.brevo.com)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-brevo-smtp-login@smtp-brevo.com
MAIL_PASSWORD=xsmtpsib-your-key-here

API_URL=http://wealthynest-api:8080/api/v1
