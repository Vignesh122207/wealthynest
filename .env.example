# Copy this file to .env and fill in your values
# cp .env.example .env

JWT_SECRET=your-256-bit-secret-here

# AES-256 key for vault (password manager) field encryption, base64-encoded
# (32 raw bytes). Generate with: openssl rand -base64 32. Never reuse across
# environments — rotating this makes all previously-stored vault items unreadable.
VAULT_ENCRYPTION_KEY=your-base64-encoded-32-byte-key-here

# Secret used to HMAC-hash vault passwords for reused-password detection (Vault Health).
# Deliberately separate from VAULT_ENCRYPTION_KEY. Generate with: openssl rand -base64 32.
VAULT_HASH_PEPPER=your-random-pepper-value-here

# Postgres/Redis credentials — used by docker-compose for both the containers
# themselves and the values the API connects with. Generate real random values,
# e.g. `openssl rand -base64 24 | tr -d '/+=' | head -c 32`. Never reuse the
# placeholder below.
DB_PASSWORD=change-this-to-a-strong-random-value
REDIS_PASSWORD=change-this-to-a-strong-random-value

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# "Web application" type OAuth 2.0 Client ID, from Google Cloud Console > APIs & Services >
# Credentials. Used by both the backend (token validation) and the browser build of
# wealthynest-web (Google Identity Services button) — add every origin you test/serve from
# (e.g. http://localhost:3000, your production domain) under this client's own "Authorized
# JavaScript origins", not here.
GOOGLE_CLIENT_ID=

# Client secret for the SAME "Web application" client as GOOGLE_CLIENT_ID above (fetch it from the
# same Credentials page). Only used for the web popup-code fallback (AuthServiceImpl
# .googleLoginPopup) when One Tap's silent prompt() is blocked/skipped — the primary web sign-in
# (ID token) never touches this. Leave unset and that fallback simply fails closed with "Google
# Sign-In isn't configured yet" instead of erroring; One Tap itself is unaffected either way.
GOOGLE_CLIENT_SECRET=

# Separate "Desktop app" type OAuth 2.0 Client ID — required for the Capacitor Android build's
# Google sign-in, which goes through a Chrome Custom Tab (see GoogleSignInButton.tsx's own
# comment for why) rather than the browser GIS flow above. This client type only allows a
# redirect URI of the exact form com.googleusercontent.apps.<this client ID>:/oauth2redirect
# (derived automatically by nativeRedirectUrlFor() in GoogleSignInButton.tsx) — the "Web
# application" client above cannot be reused for this. Leave unset and the Google button simply
# doesn't render on native builds (no error, no crash).
GOOGLE_NATIVE_CLIENT_ID=

# Required alongside GOOGLE_NATIVE_CLIENT_ID above — Google requires a client secret for this
# client type's token exchange even when PKCE is used (PKCE is additional protection, not a
# substitute). The app itself never sees this: the Custom Tab flow only returns an authorization
# code to the app, and AuthServiceImpl.googleLoginNative exchanges it for an ID token server-side,
# where this secret can be held safely. Leave both unset and native Google sign-in simply doesn't
# render, same as leaving GOOGLE_NATIVE_CLIENT_ID unset alone.
GOOGLE_NATIVE_CLIENT_SECRET=

# Comma-separated IPs/CIDRs allowed to set CF-Connecting-IP/X-Forwarded-For for rate-limiting
# purposes (see RateLimitConfig). Leave empty for pure local dev (no reverse proxy in front of
# the API). If you're running behind the Cloudflare Tunnel from docker-compose.yml's `tunnel`
# service, set this to the wealthynest-net subnet pinned in docker-compose.yml (172.19.0.0/16
# by default) — otherwise every user behind the tunnel is rate-limited as a single shared IP.
RATE_LIMIT_TRUSTED_PROXIES=

# Brevo SMTP (smtp-relay.brevo.com)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-brevo-smtp-login@smtp-brevo.com
MAIL_PASSWORD=xsmtpsib-your-key-here

# Base64-encoded Firebase service-account JSON (Project Settings > Service Accounts > Generate
# new private key, in the same Firebase project that owns wealthynest-web/android's
# google-services.json). Encode with: base64 -i service-account.json | tr -d '\n'
# Leave unset to disable push notifications — the API starts fine without it, it just never sends
# a push (in-app notifications are unaffected).
FCM_SERVICE_ACCOUNT_JSON=

API_URL=http://wealthynest-api:8080/api/v1
