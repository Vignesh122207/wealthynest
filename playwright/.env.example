# Copy to .env and fill in for your local docker-compose stack.
# cp .env.example .env

BASE_URL=http://localhost:3000
API_URL=http://localhost:8080/api/v1

# Direct Postgres connection — used ONLY to mark the seeded E2E test user's email
# as verified after registering via the API (registration always starts unverified
# and there's no SMTP inbox to click a real link from in CI). Must match the
# credentials in the repo root .env (DB_PASSWORD) — never commit real values here.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=wealthynest
DB_USER=wealthynest
DB_PASSWORD=

# Fixed credentials for the dedicated E2E test user global-setup provisions.
# A random suffix is appended to the email on each run so re-runs don't collide
# with a prior run's leftover data.
E2E_USER_EMAIL_PREFIX=e2e-test-user
E2E_USER_PASSWORD=E2eTestPassword1
